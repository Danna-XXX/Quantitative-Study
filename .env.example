# 复制此文件为 .env 并填入你的配置

# LLM提供商: aliyun 或 siliconflow
LLM_PROVIDER=siliconflow

# 你的API Key
LLM_API_KEY=sk-your-key-here

# 模型名称
# 阿里云可用: qwen-plus, qwen-max, qwen-turbo
# 硅基流动可用: deepseek-ai/DeepSeek-V3, Qwen/Qwen2.5-72B-Instruct
LLM_MODEL=deepseek-ai/DeepSeek-V3

# App密钥（用于session加密，随便填一串随机字符）
APP_SECRET_KEY=change-me-to-a-random-string-32chars
